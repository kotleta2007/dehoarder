{
  "manifest_version": 3,
  "name": "Dehoarder Bridge",
  "version": "0.1.0",
  "description": "Lets the Dehoarder web app list, close, and reopen tabs in this browser profile.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1:8765/*"]
  }
}
